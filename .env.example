# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# 対象サーバーのID（サーバー名を右クリック →「サーバーIDをコピー」）
# サーバーで動かすときは必ず設定してください。
# 未設定の場合、Bot が参加しているサーバーが1つだけならそれを使います。
GUILD_ID=

# ------------------------------------
# フォーラム・スレッド一覧（毎週自動で更新）
# ID は、開発者モードをオンにして右クリック →「ID をコピー」で取得できます。
# ------------------------------------

# 一覧を書き込むチャンネルのID
FORUM_LIST_CHANNEL_ID=

# このロールに投稿権限があるフォーラムだけを一覧に載せる（ロールのID）
FORUM_LIST_ROLE_ID=

# 一覧から除外するカテゴリーのID（複数ある場合はカンマ区切り、無ければ空のまま）
# カテゴリーに入っていないフォーラムは常に除外されます。
FORUM_LIST_EXCLUDED_CATEGORY_IDS=
